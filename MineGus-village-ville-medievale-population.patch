+                    );
+                }
+            }
+        }
+
+        return new Location(
+                world,
+                anchor.getBlockX() + 0.5D,
+                anchor.getBlockY() + 1.0D,
+                anchor.getBlockZ() + 0.5D
+        );
+    }
