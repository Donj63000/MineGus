+            if (Math.abs(lateral) == 3) {
+                for (int y = baseY + 1; y <= baseY + 4; y++) {
+                    place(tasks, sb, balcony.x(), y, balcony.z(),
+                            Material.STRIPPED_DARK_OAK_LOG);
+                }
+            }
+            if (lateral != 0) {
+                place(tasks, sb, balcony.x(), baseY + 6, balcony.z(),
+                        Material.DARK_OAK_FENCE);
