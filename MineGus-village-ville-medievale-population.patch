+
+        // Panneau d'affichage public protégé par un petit auvent.
+        int boardSide = lot.wingSide() == VillageStyle.rightOf(front) ? -1 : 1;
+        int boardLateral = boardSide * (sideRadius + 2);
+        for (int forward = -1; forward <= 1; forward++) {
