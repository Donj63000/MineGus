+    private void loadFromDisk() {
+        if (!dataFile.exists()) {
+            return;
+        }
+
+        YamlConfiguration yaml = new YamlConfiguration();
+        try {
+            yaml.load(dataFile);
+        } catch (InvalidConfigurationException exception) {
+            /*
+             * Ne jamais remplacer silencieusement un YAML invalide. Le fichier
+             * original est déplacé à côté avec un suffixe horodaté avant que le
+             * module reparte sur une base vide.
+             */
+            quarantineCorruptDataFile(exception);
+            return;
+        } catch (IOException | RuntimeException exception) {
+            /*
+             * Une erreur de lecture peut être temporaire (droits, disque, etc.).
+             * Bloquer les écritures protège le fichier existant d'un écrasement.
+             */
+            persistenceBlocked = true;
+            plugin.getLogger().log(
+                    Level.SEVERE,
+                    "[Progression] progression.yml est illisible : "
+                            + "sauvegarde désactivée jusqu'au redémarrage.",
+                    exception);
+            return;
+        }
+
+        ConfigurationSection section =
+                yaml.getConfigurationSection("players");
+        if (section == null) {
+            return;
+        }
+
+        for (String rawUuid : section.getKeys(false)) {
+            try {
+                UUID playerId = UUID.fromString(rawUuid);
+                ConfigurationSection playerSection =
+                        section.getConfigurationSection(rawUuid);
+                if (playerSection == null) {
+                    continue;
+                }
+
+                PlayerProgress data = new PlayerProgress();
+                data.lastKnownName =
+                        playerSection.getString("name", null);
+                data.xp = config.clampXp(
+                        playerSection.getLong("xp", 0L));
+                data.healthRatioToRestore = sanitizeHealthRatio(
+                        playerSection.getDouble("health-ratio", 0.0D));
+                players.put(playerId, data);
+            } catch (IllegalArgumentException exception) {
+                plugin.getLogger().warning(
+                        "[Progression] UUID invalide dans progression.yml: "
+                                + rawUuid);
+            }
+        }
+    }
+
+    private void quarantineCorruptDataFile(
+            InvalidConfigurationException parseFailure) {
+        File parent = dataFile.getParentFile();
+        File backup = parent == null
+                ? new File(dataFile.getName()
+                        + ".corrupt-" + System.currentTimeMillis() + ".bak")
+                : new File(parent, dataFile.getName()
+                        + ".corrupt-" + System.currentTimeMillis() + ".bak");
+        try {
+            Files.move(
+                    dataFile.toPath(),
+                    backup.toPath(),
+                    StandardCopyOption.REPLACE_EXISTING);
+            plugin.getLogger().log(
+                    Level.SEVERE,
+                    "[Progression] progression.yml était invalide et a été "
+                            + "mis en quarantaine dans " + backup.getName()
+                            + ". Une nouvelle sauvegarde saine sera créée.",
+                    parseFailure);
+        } catch (IOException | RuntimeException backupFailure) {
+            persistenceBlocked = true;
+            plugin.getLogger().log(
+                    Level.SEVERE,
+                    "[Progression] progression.yml est invalide et sa copie de "
+                            + "sécurité a échoué : sauvegarde désactivée pour "
+                            + "éviter toute perte. Cause YAML : "
+                            + parseFailure.getMessage(),
+                    backupFailure);
+        }
+    }
+
+    private Map<UUID, SavedProgress> snapshotPlayers() {
+        Map<UUID, SavedProgress> snapshot =
+                new HashMap<>();
+        for (Map.Entry<UUID, PlayerProgress> entry
+                : players.entrySet()) {
+            PlayerProgress data = entry.getValue();
+            snapshot.put(
+                    entry.getKey(),
+                    new SavedProgress(
+                            data.lastKnownName,
+                            config.clampXp(data.xp),
+                            sanitizeHealthRatio(
+                                    data.healthRatioToRestore)));
+        }
+        return snapshot;
+    }
+
+    private String serializeSnapshot(
+            Map<UUID, SavedProgress> snapshot) {
+        YamlConfiguration yaml = new YamlConfiguration();
+        yaml.set("schema-version", 2);
+        yaml.set("max-level", config.maxLevel);
+
+        List<Map.Entry<UUID, SavedProgress>> entries =
+                new ArrayList<>(snapshot.entrySet());
+        entries.sort(
+                Comparator.comparing(
+                        entry -> entry.getKey().toString()));
+
+        ConfigurationSection playersSection =
+                yaml.createSection("players");
+        for (Map.Entry<UUID, SavedProgress> entry : entries) {
+            ConfigurationSection playerSection =
+                    playersSection.createSection(
+                            entry.getKey().toString());
+            SavedProgress data = entry.getValue();
+            playerSection.set("name", data.lastKnownName());
+            playerSection.set("xp", data.xp());
+            playerSection.set(
+                    "health-ratio",
+                    data.healthRatioToRestore());
+        }
+        return yaml.saveToString();
+    }
+
+    private boolean writeSerializedSnapshot(
+            String serializedYaml,
+            long version) {
+        if (persistenceBlocked) {
+            return false;
+        }
+
+        synchronized (diskWriteLock) {
+            if (version <= latestWrittenVersion) {
+                return true;
+            }
+
+            File parent = dataFile.getParentFile();
+            try {
+                if (parent != null && !parent.exists()) {
+                    Files.createDirectories(parent.toPath());
+                }
+                File temporary = parent == null
+                        ? new File(dataFile.getName() + ".tmp")
+                        : new File(parent, dataFile.getName() + ".tmp");
+                Files.writeString(
+                        temporary.toPath(),
+                        serializedYaml,
+                        StandardCharsets.UTF_8,
+                        StandardOpenOption.CREATE,
+                        StandardOpenOption.TRUNCATE_EXISTING,
+                        StandardOpenOption.WRITE);
+                try {
+                    Files.move(
+                            temporary.toPath(),
+                            dataFile.toPath(),
+                            StandardCopyOption.ATOMIC_MOVE,
+                            StandardCopyOption.REPLACE_EXISTING);
+                } catch (AtomicMoveNotSupportedException exception) {
+                    Files.move(
+                            temporary.toPath(),
+                            dataFile.toPath(),
+                            StandardCopyOption.REPLACE_EXISTING);
+                }
+                latestWrittenVersion = version;
+                return true;
+            } catch (IOException | RuntimeException exception) {
+                plugin.getLogger().log(
+                        Level.WARNING,
+                        "[Progression] Impossible de sauvegarder progression.yml",
+                        exception);
+                return false;
+            }
+        }
+    }
+
+    private void markDirtyAndScheduleSave() {
+        synchronized (saveStateLock) {
+            dirtyVersion++;
+            if (shuttingDown || persistenceBlocked) {
+                return;
+            }
+        }
+        requestSave(SAVE_DEBOUNCE_TICKS);
+    }
+
+    /**
+     * Regroupe les gains rapprochés au lieu d'écrire progression.yml à chaque
+     * bloc cassé. L'instantané reste créé sur le thread principal ; seule
+     * l'écriture disque est exécutée de façon asynchrone.
+     */
+    private void requestSave(long delayTicks) {
+        synchronized (saveStateLock) {
+            if (shuttingDown || persistenceBlocked) {
+                return;
+            }
+            if (saveInProgress) {
+                saveQueued = true;
+                return;
+            }
+            if (pendingSaveTask != null
+                    && !pendingSaveTask.isCancelled()) {
+                return;
+            }
+
+            try {
+                pendingSaveTask = Bukkit.getScheduler().runTaskLater(
+                        plugin,
+                        this::startAsyncSave,
+                        Math.max(1L, delayTicks));
+            } catch (IllegalPluginAccessException exception) {
+                pendingSaveTask = null;
+                plugin.getLogger().fine(
+                        "[Progression] Sauvegarde différée ignorée pendant l'arrêt.");
+            }
+        }
+    }
+
+    private void startAsyncSave() {
+        final Map<UUID, SavedProgress> snapshot;
+        final long version;
+
+        synchronized (saveStateLock) {
+            pendingSaveTask = null;
+            if (shuttingDown || persistenceBlocked) {
+                return;
+            }
+            if (saveInProgress) {
+                saveQueued = true;
+                return;
+            }
+
+            /*
+             * Les données joueurs sont confinées au thread serveur. Les copier
+             * ici évite toute lecture concurrente de la HashMap dans le worker.
+             */
+            snapshot = snapshotPlayers();
+            version = dirtyVersion;
+            saveInProgress = true;
+            saveQueued = false;
+        }
+
+        /*
+         * La sérialisation Bukkit/YAML reste elle aussi sur le thread serveur.
+         * Le worker n'effectue ensuite que les opérations de fichiers Java.
+         */
+        final String serializedYaml;
+        try {
+            serializedYaml = serializeSnapshot(snapshot);
+        } catch (RuntimeException exception) {
+            plugin.getLogger().log(
+                    Level.WARNING,
+                    "[Progression] Impossible de sérialiser progression.yml",
+                    exception);
+            finishAsyncSave(false);
+            return;
+        }
+
+        try {
+            Bukkit.getScheduler().runTaskAsynchronously(
+                    plugin,
+                    () -> {
+                        boolean written = writeSerializedSnapshot(
+                                serializedYaml,
+                                version);
+                        finishAsyncSave(written);
+                    });
+        } catch (IllegalPluginAccessException exception) {
+            synchronized (saveStateLock) {
+                saveInProgress = false;
+                saveQueued = true;
+            }
+            plugin.getLogger().fine(
+                    "[Progression] Écriture asynchrone ignorée pendant l'arrêt.");
+        }
+    }
+
+    private void finishAsyncSave(boolean written) {
+        final boolean shouldReschedule;
+        synchronized (saveStateLock) {
+            saveInProgress = false;
+            shouldReschedule = saveQueued
+                    || !written
+                    || dirtyVersion > latestWrittenVersion;
+            saveQueued = false;
+        }
+
+        if (!shouldReschedule
+                || shuttingDown
+                || persistenceBlocked) {
+            return;
+        }
+
+        long delay = written
+                ? SAVE_DEBOUNCE_TICKS
+                : SAVE_RETRY_TICKS;
+        try {
+            /*
+             * Le callback revient d'abord sur le thread principal afin que la
+             * future photographie de players reste sûre.
+             */
+            Bukkit.getScheduler().runTask(
+                    plugin,
+                    () -> requestSave(delay));
+        } catch (IllegalPluginAccessException exception) {
+            plugin.getLogger().fine(
+                    "[Progression] Replanification ignorée pendant l'arrêt.");
+        }
+    }
+
+    private Integer parseLevel(String raw) {
+        try {
+            int level = Integer.parseInt(raw);
+            return level >= 1 && level <= config.maxLevel
+                    ? level
+                    : null;
+        } catch (NumberFormatException exception) {
+            return null;
+        }
+    }
+
+    private static Long parsePositiveLong(String raw) {
+        try {
+            long value = Long.parseLong(raw);
+            return value > 0L ? value : null;
+        } catch (NumberFormatException exception) {
+            return null;
+        }
+    }
+
+    private static List<String> filterPrefix(
+            List<String> values,
+            String prefix) {
+        String normalized = prefix == null
+                ? ""
+                : prefix.toLowerCase(Locale.ROOT);
+        return values.stream()
+                .filter(value -> value.toLowerCase(Locale.ROOT)
+                        .startsWith(normalized))
+                .sorted(String.CASE_INSENSITIVE_ORDER)
+                .toList();
+    }
+
+    private static boolean isWood(Material material) {
+        if (material == null) {
+            return false;
+        }
+        String name = material.name();
+        return name.endsWith("_LOG")
+                || name.endsWith("_STEM")
+                || name.endsWith("_HYPHAE");
+    }
+
+    private static String formatPercent(double value) {
+        if (Math.abs(value - Math.rint(value)) < 0.0001D) {
+            return Long.toString(Math.round(value));
+        }
+        return String.format(Locale.ROOT, "%.1f", value);
+    }
+
+    private static long saturatingAdd(long left, long right) {
+        if (right > 0L && left > Long.MAX_VALUE - right) {
+            return Long.MAX_VALUE;
+        }
+        return left + right;
+    }
+
+    private static final class PlayerProgress {
+        private String lastKnownName;
+        private long xp;
+        private Double healthRatioToRestore;
+    }
+
+    private static final class RateWindow {
+        private long startedAtNanos;
+        private long granted;
+
+        private RateWindow(long startedAtNanos) {
+            this.startedAtNanos = startedAtNanos;
+        }
+    }
+
+    private record SavedProgress(
+            String lastKnownName,
+            long xp,
+            Double healthRatioToRestore) {
+    }
+
+    private record PlayerTarget(
+            UUID playerId,
+            String displayName,
+            Player onlinePlayer) {
+    }
+}
diff --git a/src/main/java/org/example/progression/PlacedBlockTracker.java b/src/main/java/org/example/progression/PlacedBlockTracker.java
new file mode 100644
index 0000000000000000000000000000000000000000..0d80639dd6d7beda262a34d15f568c8e59240d97
--- /dev/null
+++ b/src/main/java/org/example/progression/PlacedBlockTracker.java
@@ -0,0 +1,324 @@
+package org.example.progression;
+
+import org.bukkit.Bukkit;
+import org.bukkit.Chunk;
+import org.bukkit.World;
+import org.bukkit.block.Block;
+import org.bukkit.block.BlockFace;
+import org.bukkit.persistence.PersistentDataContainer;
+import org.bukkit.persistence.PersistentDataType;
+import org.bukkit.plugin.java.JavaPlugin;
+import org.bukkit.scheduler.BukkitTask;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.UUID;
+
+/**
+ * Mémorise les blocs posés ou générés artificiellement qui donnent de l'XP.
+ *
+ * <p>Le marquage est stocké dans le {@link PersistentDataContainer} du chunk :
+ * une roche ou un minerai posé puis récupéré après un redémarrage ne peut donc
+ * pas être recyclé à l'infini. Les écritures NBT sont regroupées et vidées
+ * périodiquement ainsi qu'au déchargement du chunk.</p>
+ */
+final class PlacedBlockTracker {
+
+    private static final byte SATURATED = 1;
+
+    private final JavaPlugin plugin;
+    private final boolean enabled;
+    private final int maxEntriesPerChunk;
+    private final org.bukkit.NamespacedKey positionsKey;
+    private final org.bukkit.NamespacedKey saturatedKey;
+    private final Map<ChunkKey, ChunkState> states = new HashMap<>();
+
+    private BukkitTask flushTask;
+    private boolean persistenceWarningLogged;
+
+    PlacedBlockTracker(
+            JavaPlugin plugin,
+            boolean enabled,
+            int maxEntriesPerChunk,
+            long flushTicks) {
+        this.plugin = plugin;
+        this.enabled = enabled;
+        this.maxEntriesPerChunk = Math.max(256, maxEntriesPerChunk);
+        this.positionsKey = new org.bukkit.NamespacedKey(
+                plugin,
+                "progression_placed_blocks");
+        this.saturatedKey = new org.bukkit.NamespacedKey(
+                plugin,
+                "progression_placed_saturated");
+
+        if (enabled) {
+            this.flushTask = Bukkit.getScheduler().runTaskTimer(
+                    plugin,
+                    this::flushDirtyLoadedChunks,
+                    Math.max(20L, flushTicks),
+                    Math.max(20L, flushTicks));
+        }
+    }
+
+    boolean isEnabled() {
+        return enabled;
+    }
+
+    /**
+     * Marque un bloc comme non éligible à l'XP de minage.
+     */
+    void mark(Block block) {
+        if (!enabled || block == null) {
+            return;
+        }
+
+        ChunkState state = stateFor(block.getChunk());
+        if (state.saturated) {
+            return;
+        }
+
+        if (state.positions.add(encodePosition(block))) {
+            state.dirty = true;
+            if (state.positions.size() >= maxEntriesPerChunk) {
+                // Un chunk de construction massif ne doit pas produire un NBT
+                // sans limite. Une fois saturé, tout minage XP y est neutralisé.
+                state.positions.clear();
+                state.saturated = true;
+            }
+        }
+    }
+
+    /**
+     * Retourne {@code true} si le bloc était marqué, puis retire son marqueur.
+     *
+     * <p>Un chunk saturé reste volontairement saturé : cette stratégie sûre
+     * empêche qu'un très grand bâtiment en pierre devienne une ferme à XP.</p>
+     */
+    boolean consume(Block block) {
+        if (!enabled || block == null) {
+            return false;
+        }
+
+        ChunkState state = stateFor(block.getChunk());
+        if (state.saturated) {
+            return true;
+        }
+
+        boolean removed = state.positions.remove(encodePosition(block));
+        if (removed) {
+            state.dirty = true;
+        }
+        return removed;
+    }
+
+    /**
+     * Transfère atomiquement les marqueurs d'un ensemble déplacé par piston.
+     *
+     * <p>La photographie préalable est indispensable : dans une ligne de
+     * blocs, la destination du premier est souvent la source du suivant. Un
+     * transfert bloc par bloc pourrait alors absorber le marqueur que nous
+     * venons juste de déplacer.</p>
+     */
+    void moveAll(
+            Iterable<? extends Block> movedBlocks,
+            BlockFace movementDirection) {
+        if (!enabled
+                || movedBlocks == null
+                || movementDirection == null) {
+            return;
+        }
+
+        ArrayList<BlockMovement> movements = new ArrayList<>();
+        for (Block source : movedBlocks) {
+            if (source == null) {
+                continue;
+            }
+            movements.add(new BlockMovement(
+                    source,
+                    source.getRelative(movementDirection),
+                    isMarked(source)));
+        }
+
+        // Retirer d'abord toutes les anciennes positions, puis seulement
+        // inscrire les destinations afin de gérer correctement les recouvrements.
+        for (BlockMovement movement : movements) {
+            if (movement.artificial()) {
+                consume(movement.source());
+            }
+        }
+        for (BlockMovement movement : movements) {
+            if (movement.artificial()) {
+                mark(movement.destination());
+            }
+        }
+    }
+
+    /**
+     * Sauvegarde puis retire le cache associé au chunk en cours de déchargement.
+     */
+    void onChunkUnload(Chunk chunk) {
+        if (!enabled || chunk == null) {
+            return;
+        }
+
+        ChunkKey key = ChunkKey.of(chunk);
+        ChunkState state = states.remove(key);
+        if (state != null && state.dirty) {
+            flush(chunk, state);
+        }
+    }
+
+    void shutdown() {
+        if (flushTask != null) {
+            flushTask.cancel();
+            flushTask = null;
+        }
+        flushDirtyLoadedChunks();
+        states.clear();
+    }
+
+    static int encodePosition(int x, int y, int z) {
+        /*
+         * 20 bits pour Y et 4 bits pour chaque coordonnée locale X/Z.
+         * L'encodage sert uniquement de clé d'égalité et reste donc stable
+         * pour les hauteurs négatives comme pour les mondes personnalisés.
+         */
+        return ((y & 0xFFFFF) << 8)
+                | ((z & 0x0F) << 4)
+                | (x & 0x0F);
+    }
+
+    private static int encodePosition(Block block) {
+        return encodePosition(block.getX(), block.getY(), block.getZ());
+    }
+
+    boolean isMarked(Block block) {
+        if (!enabled || block == null) {
+            return false;
+        }
+        ChunkState state = stateFor(block.getChunk());
+        return state.saturated
+                || state.positions.contains(encodePosition(block));
+    }
+
+    private ChunkState stateFor(Chunk chunk) {
+        ChunkKey key = ChunkKey.of(chunk);
+        return states.computeIfAbsent(key, ignored -> load(chunk));
+    }
+
+    private ChunkState load(Chunk chunk) {
+        ChunkState state = new ChunkState();
+        try {
+            PersistentDataContainer pdc = chunk.getPersistentDataContainer();
+            Byte saturated = pdc.get(saturatedKey, PersistentDataType.BYTE);
+            state.saturated = saturated != null && saturated == SATURATED;
+
+            if (!state.saturated) {
+                int[] encoded = pdc.get(
+                        positionsKey,
+                        PersistentDataType.INTEGER_ARRAY);
+                if (encoded != null) {
+                    for (int value : encoded) {
+                        state.positions.add(value);
+                        if (state.positions.size() >= maxEntriesPerChunk) {
+                            state.positions.clear();
+                            state.saturated = true;
+                            state.dirty = true;
+                            break;
+                        }
+                    }
+                }
+            }
+        } catch (Throwable throwable) {
+            logPersistenceWarning(throwable);
+        }
+        return state;
+    }
+
+    private void flushDirtyLoadedChunks() {
+        if (!enabled || states.isEmpty()) {
+            return;
+        }
+
+        for (Map.Entry<ChunkKey, ChunkState> entry
+                : new ArrayList<>(states.entrySet())) {
+            ChunkState state = entry.getValue();
+            if (!state.dirty) {
+                continue;
+            }
+
+            ChunkKey key = entry.getKey();
+            World world = Bukkit.getWorld(key.worldId());
+            if (world == null || !world.isChunkLoaded(key.x(), key.z())) {
+                // ChunkUnloadEvent effectue normalement la dernière écriture.
+                // Si le monde a déjà disparu, conserver l'état en mémoire évite
+                // de prétendre à tort que les données ont été persistées.
+                continue;
+            }
+            flush(world.getChunkAt(key.x(), key.z()), state);
+        }
+    }
+
+    private void flush(Chunk chunk, ChunkState state) {
+        try {
+            PersistentDataContainer pdc = chunk.getPersistentDataContainer();
+            if (state.saturated) {
+                pdc.set(saturatedKey, PersistentDataType.BYTE, SATURATED);
+                pdc.remove(positionsKey);
+            } else {
+                pdc.remove(saturatedKey);
+                if (state.positions.isEmpty()) {
+                    pdc.remove(positionsKey);
+                } else {
+                    int[] encoded = state.positions.stream()
+                            .mapToInt(Integer::intValue)
+                            .sorted()
+                            .toArray();
+                    pdc.set(
+                            positionsKey,
+                            PersistentDataType.INTEGER_ARRAY,
+                            encoded);
+                }
+            }
+            state.dirty = false;
+        } catch (Throwable throwable) {
+            logPersistenceWarning(throwable);
+        }
+    }
+
+    private void logPersistenceWarning(Throwable throwable) {
+        if (persistenceWarningLogged) {
+            return;
+        }
+        persistenceWarningLogged = true;
+        plugin.getLogger().warning(
+                "[Progression] Le marquage persistant des blocs poses "
+                        + "n'est pas disponible dans cet environnement ("
+                        + throwable.getClass().getSimpleName()
+                        + "). La protection reste active en memoire.");
+    }
+
+    private record BlockMovement(
+            Block source,
+            Block destination,
+            boolean artificial) {
+    }
+
+    private record ChunkKey(UUID worldId, int x, int z) {
+        static ChunkKey of(Chunk chunk) {
+            return new ChunkKey(
+                    chunk.getWorld().getUID(),
+                    chunk.getX(),
+                    chunk.getZ());
+        }
+    }
+
+    private static final class ChunkState {
+        private final Set<Integer> positions = new HashSet<>();
+        private boolean saturated;
+        private boolean dirty;
+    }
+}
diff --git a/src/main/java/org/example/progression/ProgressionConfig.java b/src/main/java/org/example/progression/ProgressionConfig.java
new file mode 100644
index 0000000000000000000000000000000000000000..646e7f0ec9c35b2aa1d58bc11fe201c60312ab44
--- /dev/null
+++ b/src/main/java/org/example/progression/ProgressionConfig.java
@@ -0,0 +1,632 @@
+package org.example.progression;
+
+import org.bukkit.Material;
+import org.bukkit.NamespacedKey;
+import org.bukkit.configuration.ConfigurationSection;
+import org.bukkit.entity.EntityType;
+import org.bukkit.plugin.java.JavaPlugin;
+
+import java.util.Collections;
+import java.util.EnumMap;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Configuration immuable du niveau global.
+ *
+ * <p>Les valeurs par défaut sont aussi présentes dans le code afin que le
+ * système fonctionne immédiatement sur un serveur possédant déjà un ancien
+ * {@code config.yml}. En effet, {@code saveDefaultConfig()} ne fusionne pas
+ * automatiquement les nouvelles clés dans un fichier existant.</p>
+ */
+final class ProgressionConfig {
+
+    static final int ABSOLUTE_MAX_LEVEL = 100;
+
